# Copy to .env (never commit it). See docs/architecture/m6-cloud-persistence.md.

# Postgres connection string (Neon). Without it the API runs on in-process Postgres: development only.
DATABASE_URL=postgres://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# `neon` verifies Neon Auth JWTs. `fake` accepts `test:<id>` tokens and is refused when NODE_ENV=production.
AUTH_MODE=neon
# The Auth URL from Neon Console > Settings > Better Auth; its origin is the expected token issuer.
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.region.aws.neon.tech/neondb/auth
# Optional; defaults to <NEON_AUTH_BASE_URL>/.well-known/jwks.json
# NEON_AUTH_JWKS_URL=

# Comma-separated web origins allowed by CORS.
CORS_ORIGIN=http://localhost:5173
PORT=8787
