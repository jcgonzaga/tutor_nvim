    "@tutor-nvim/pedagogy": "workspace:*",
    "@tutor-nvim/shared": "workspace:*",
    "@tutor-nvim/vim-engine": "workspace:*",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.6.0",
    "jose": "^6.1.0",
    "pg": "^8.16.0",
    "tsx": "^4.20.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.0"
